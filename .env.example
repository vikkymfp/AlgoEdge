ALGOEDGE_APP_NAME=AlgoEdge
ALGOEDGE_DISPLAY_NAME=Your Name
ALGOEDGE_ENVIRONMENT=development
ALGOEDGE_SYMBOL=AAPL
ALGOEDGE_PERIOD=6mo
ALGOEDGE_INTERVAL=1d
ALGOEDGE_SHORT_WINDOW=20
ALGOEDGE_LONG_WINDOW=50
ALGOEDGE_INITIAL_CASH=100000
ALGOEDGE_LIVE_TRADING=false
ALGOEDGE_BROKER=paper
# Groww API key + secret are the persistent credentials; the access token
# (session) is generated from them and renewed automatically.
ALGOEDGE_GROWW_API_KEY=
ALGOEDGE_GROWW_API_SECRET=
# Optional, advanced: a pre-generated session token (e.g. for TOTP keys).
# Used as-is and NOT renewed automatically. Leave blank with a key/secret.
ALGOEDGE_GROWW_ACCESS_TOKEN=
ALGOEDGE_GROWW_EXCHANGE=NSE
ALGOEDGE_GROWW_QUANTITY=1
ALGOEDGE_GROWW_PRODUCT=CNC
ALGOEDGE_GROWW_ORDER_TYPE=MARKET
# Optional: local SQL Server persistence for strategy signals, orders, and
# risk-manager state. Leave ALGOEDGE_DB_SERVER blank to disable it entirely -
# the app runs fine without a database.
ALGOEDGE_DB_SERVER=
ALGOEDGE_DB_NAME=AlgoEdge
ALGOEDGE_DB_TRUSTED_CONNECTION=true
ALGOEDGE_DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server
# Optional: encrypts broker credentials/tokens at rest when you update them
# from the API Management page. Generate one locally, once:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave blank to disable DB-backed credential storage (UI updates still work
# for the current process, just won't survive a restart).
ALGOEDGE_CREDENTIAL_ENCRYPTION_KEY=
# Optional: Net P&L cost model for real (live) trades - all default to 0.0
# ("not yet configured") until you supply your account's actual current
# published Groww brokerage/STT/exchange-charge/GST/stamp-duty rates.
ALGOEDGE_COST_BROKERAGE_PER_ORDER=0
ALGOEDGE_COST_STT_PERCENT_ON_SELL=0
ALGOEDGE_COST_EXCHANGE_CHARGES_PERCENT=0
ALGOEDGE_COST_GST_PERCENT=0
ALGOEDGE_COST_STAMP_DUTY_PERCENT_ON_BUY=0
# Dashboard sign-in (access control only; never changes LIVE_TRADING/BROKER).
# Users live in the existing users table - create the first ADMIN with:
#   PYTHONPATH=src python -m algoedge.auth_cli create-user --email you@example.com --role ADMIN
ALGOEDGE_AUTH_PASSWORD_MIN_LENGTH=8
ALGOEDGE_AUTH_LOCKOUT_THRESHOLD=5
ALGOEDGE_AUTH_LOCKOUT_MINUTES=15
ALGOEDGE_AUTH_SESSION_IDLE_MINUTES=30
ALGOEDGE_AUTH_SESSION_ABSOLUTE_MINUTES=480
ALGOEDGE_AUTH_SESSION_REVALIDATE_SECONDS=60
ALGOEDGE_AUTH_CAPTCHA_TTL_SECONDS=120
ALGOEDGE_AUTH_CAPTCHA_RATE_LIMIT=60
ALGOEDGE_AUTH_CAPTCHA_RATE_WINDOW_SECONDS=300
ALGOEDGE_AUTH_LOGIN_RATE_LIMIT=20
ALGOEDGE_AUTH_LOGIN_RATE_WINDOW_SECONDS=300
# auto = Secure cookie only when the request itself is HTTPS. Behind a
# TLS-terminating proxy set this to true.
ALGOEDGE_AUTH_COOKIE_SECURE=auto
# Optional: unauthenticated GET of status/alerts/option-context from a direct
# 127.0.0.1 connection only (never via a proxy, never a POST). Off by default.
ALGOEDGE_AUTH_LOOPBACK_READONLY_EXEMPT=false
